<div
  class="collection-hero color-{{ section.settings.color_scheme }}"
  style="
    --collection-hero-padding-top: {{ section.settings.padding-block-start }}px;
    --collection-hero-padding-bottom: {{ section.settings.padding-block-end }}px;
    --collection-hero-background: {{ section.settings.background_color | default: '#F2F7FB' }};
  "
>
  <div class="page-width">
    <div class="collection-hero__content">
      {% if collection.title != blank %}
        <h1 class="collection-hero__heading">{{ collection.title }}</h1>
      {% endif %}

      {% if collection.description != blank %}
        <div class="collection-hero__description">{{ collection.description }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-hero {
    position: relative;
    padding-block-start: var(--collection-hero-padding-top, 64px);
    padding-block-end: var(--collection-hero-padding-bottom, 64px);
    background-color: var(--collection-hero-background, #F2F7FB);
    overflow: hidden;
  }

  .collection-hero__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 495px;
  }

  .collection-hero__heading {
    font-size: 56px;
    line-height: 73px;
    letter-spacing: -1.12px;
    font-weight: 400;
    margin: 0;
    color: var(--color-foreground);
  }

  .collection-hero__description {
    font-size: 18px;
    line-height: 25px;
    font-weight: 400;
    color: var(--color-foreground);
  }

  @media screen and (max-width: 749px) {
    .collection-hero {
      padding-block-start: 100px;
      padding-block-end: 24px;
      padding-inline: 18px;
    }

    .collection-hero__content {
      gap: 12px;
      max-width: 100%;
    }

    .collection-hero__heading {
      font-size: 30px;
      line-height: 36px;
      letter-spacing: -0.6px;
    }

    .collection-hero__description {
      font-size: 14px;
      line-height: 20px;
      letter-spacing: 0.14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F2F7FB"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}
