{% liquid
  assign color_scheme = section.settings.color_scheme
  assign section_width = section.settings.section_width
  assign blog = section.settings.blog
  assign post_count = section.settings.post_count
  assign heading = section.settings.heading
  assign button_text = section.settings.button_text
  assign mobile_button_text = section.settings.mobile_button_text
  assign button_url = section.settings.button_url
%}

<div class="section-background color-{{ color_scheme }}"></div>
<div
  class="section section--{{ section_width }} color-{{ color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="from-the-blog-{{ section.id }}"
>
  <div class="from-the-blog" id="from-the-blog-{{ section.id }}">
    {%- comment -%} Header row {%- endcomment -%}
    <div class="from-the-blog__header">
      {% if heading != blank %}
        <h2 class="from-the-blog__heading">{{ heading | escape }}</h2>
      {% endif %}

      {% if button_text != blank and button_url != blank %}
        <a href="{{ button_url }}" class="from-the-blog__cta-desktop hidden--mobile">
          {{- button_text | escape -}}
        </a>
      {% endif %}
    </div>

    {%- comment -%} Blog cards grid {%- endcomment -%}
    {% if blog != blank and blog.articles.size > 0 %}
      <div class="from-the-blog__grid">
        {% for article in blog.articles limit: post_count %}
          <a href="{{ article.url }}" class="from-the-blog__card">
            <div class="from-the-blog__card-image">
              {% if article.image != blank %}
                {%- assign sizes_val = '(min-width: 750px) 33vw, 100vw' -%}
                {{
                  article.image
                  | image_url: width: article.image.width
                  | image_tag:
                    sizes: sizes_val,
                    widths: '354,494,550,750,988',
                    loading: 'lazy',
                    class: 'from-the-blog__image',
                    alt: article.image.alt | default: article.title
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'from-the-blog__placeholder' }}
              {% endif %}
            </div>

            <div class="from-the-blog__card-content">
              <p class="from-the-blog__meta">
                {% if article.tags.size > 0 %}
                  <span>{{ article.tags.first }}</span>
                {% endif %}
                {% if article.tags.size > 0 %}
                  <span class="from-the-blog__meta-separator">&bull;</span>
                {% endif %}
                {% liquid
                  assign word_count = article.content | strip_html | split: ' ' | size
                  assign read_time = word_count | divided_by: 200 | plus: 1
                %}
                <span>{{ read_time }} min read</span>
              </p>

              <h3 class="from-the-blog__title">{{ article.title | escape }}</h3>
            </div>
          </a>
        {% endfor %}
      </div>

      {% if mobile_button_text != blank and button_url != blank %}
        <a href="{{ button_url }}" class="button from-the-blog__cta-mobile hidden--desktop">
          {{- mobile_button_text | escape -}}
        </a>
      {% endif %}
    {% else %}
      {%- comment -%} Onboarding / placeholder content {%- endcomment -%}
      <div class="from-the-blog__grid">
        {% for i in (1..post_count) %}
          <div class="from-the-blog__card">
            <div class="from-the-blog__card-image">
              {{ 'image' | placeholder_svg_tag: 'from-the-blog__placeholder' }}
            </div>
            <div class="from-the-blog__card-content">
              <p class="from-the-blog__meta">
                <span>Category</span>
                <span class="from-the-blog__meta-separator">&bull;</span>
                <span>5 min read</span>
              </p>
              <h3 class="from-the-blog__title">Blog post title</h3>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .from-the-blog {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .from-the-blog__header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .from-the-blog__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 26px;
    line-height: 34px;
    letter-spacing: -0.52px;
    color: var(--color-foreground);
    margin: 0;
  }

  .from-the-blog__cta-desktop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-foreground);
    border-radius: 57px;
    padding: 10px 34px 13px 34px;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-style: var(--font-body--style);
    font-size: 16px;
    line-height: 23px;
    color: var(--color-foreground);
    text-decoration: none;
    background: transparent;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .from-the-blog__cta-desktop:hover {
    opacity: 0.7;
  }

  .from-the-blog__grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .from-the-blog__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-decoration: none;
    color: inherit;
  }

  .from-the-blog__card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 354 / 260;
    background-color: #D3D8DD;
  }

  .from-the-blog__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .from-the-blog__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .from-the-blog__card-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .from-the-blog__meta {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-style: var(--font-subheading--style);
    font-size: 10px;
    line-height: 14px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .from-the-blog__meta-separator {
    margin-inline: 4px;
  }

  .from-the-blog__title {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 22px;
    line-height: 29px;
    letter-spacing: -0.22px;
    color: var(--color-foreground);
    margin: 0;
  }

  .from-the-blog__cta-mobile {
    align-self: center;
    border-radius: 60px;
    padding: 10px 24px 12px 24px;
    font-size: 14px;
    line-height: 20px;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .from-the-blog {
      gap: 32px;
    }

    .from-the-blog__heading {
      font-size: 42px;
      line-height: 55px;
      letter-spacing: -0.84px;
    }

    .from-the-blog__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }

    .from-the-blog__card {
      gap: 32px;
    }

    .from-the-blog__card-image {
      aspect-ratio: 1 / 1;
    }

    .from-the-blog__meta {
      font-size: 14px;
      line-height: 20px;
      letter-spacing: 0.56px;
    }

    .from-the-blog__title {
      font-size: 36px;
      line-height: 47px;
      letter-spacing: -0.36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "From the Blog",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Blog"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "mobile_button_text",
      "label": "Mobile button text",
      "default": "View All Articles"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "post_count",
      "label": "Posts to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "From the Blog",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
