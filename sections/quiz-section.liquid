{% liquid
  assign color_scheme = section.settings.color_scheme
  assign section_width = section.settings.section_width
%}

<div class="section-background color-{{ color_scheme }}"></div>
<div
  class="section section--{{ section_width }} quiz-section color-{{ color_scheme }} spacing-style"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
  "
  data-testid="quiz-section-{{ section.id }}"
>
  {%- comment -%} Content panel {%- endcomment -%}
  <div class="quiz-section__content">
    <div class="quiz-section__content-inner">
      <div class="quiz-section__text-group">
        {% if section.settings.subtitle != blank %}
          <p class="quiz-section__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="quiz-section__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="quiz-section__description">{{ section.settings.description | escape }}</p>
        {% endif %}
      </div>

      {% if section.settings.contaminant_label != blank or section.settings.contaminant_list != blank %}
        <div class="quiz-section__card">
          <div class="quiz-section__card-text">
            {% if section.settings.contaminant_label != blank %}
              <p class="quiz-section__card-label">{{ section.settings.contaminant_label | escape }}</p>
            {% endif %}
            {% if section.settings.contaminant_list != blank %}
              <p class="quiz-section__card-list">{{ section.settings.contaminant_list | escape }}</p>
            {% endif %}
          </div>
          <div class="quiz-section__card-right" aria-hidden="true">
            <svg class="quiz-section__starburst" width="46" height="46" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g stroke="#202635" stroke-width="1.33" stroke-linecap="round">
                <line x1="23" y1="1" x2="23" y2="45"/>
                <line x1="1" y1="23" x2="45" y2="23"/>
                <line x1="6.4" y1="6.4" x2="39.6" y2="39.6"/>
                <line x1="39.6" y1="6.4" x2="6.4" y2="39.6"/>
              </g>
              <g stroke="#202635" stroke-width="0.8" stroke-linecap="round">
                <line x1="23" y1="5" x2="23" y2="41" transform="rotate(22.5 23 23)"/>
                <line x1="23" y1="5" x2="23" y2="41" transform="rotate(67.5 23 23)"/>
                <line x1="23" y1="5" x2="23" y2="41" transform="rotate(112.5 23 23)"/>
                <line x1="23" y1="5" x2="23" y2="41" transform="rotate(157.5 23 23)"/>
              </g>
            </svg>
          </div>
        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          {% if section.settings.button_url != blank %}
            href="{{ section.settings.button_url }}"
          {% endif %}
          class="button quiz-section__btn"
        >
          {{- section.settings.button_text | escape -}}
        </a>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Media panel {%- endcomment -%}
  <div class="quiz-section__media">
    {% if section.settings.background_image != blank %}
      <div class="quiz-section__media-bg" aria-hidden="true">
        {{
          section.settings.background_image
          | image_url: width: section.settings.background_image.width
          | image_tag:
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '375,550,750,1000',
            loading: 'lazy',
            class: 'quiz-section__media-bg-image',
            alt: ''
        }}
      </div>
    {% endif %}

    <div class="quiz-section__gauge-wrapper">
      <svg class="quiz-section__gauge" viewBox="0 0 444 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="gauge-grad-{{ section.id }}" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stop-color="#3383C5"/>
            <stop offset="75%" stop-color="#B8CCE0"/>
            <stop offset="100%" stop-color="#D4C5A0"/>
          </linearGradient>
        </defs>
        {%- comment -%} Outer track: semi-elliptical arc from bottom-left over the top to bottom-right {%- endcomment -%}
        <path d="M 49,275 A 200,110 0 1 0 395,275" stroke="#F2F7FB" stroke-width="8" fill="none" opacity="0.2" stroke-linecap="round"/>
        {%- comment -%} Inner progress arc: blue gradient from bottom-left to upper-right {%- endcomment -%}
        <path d="M 49,275 A 200,110 0 0 0 363,142" stroke="url(#gauge-grad-{{ section.id }})" stroke-width="8" fill="none" stroke-linecap="round"/>
      </svg>
      {% if section.settings.contaminant_count != blank %}
        <span class="quiz-section__count">{{ section.settings.contaminant_count | escape }}</span>
      {% endif %}
    </div>

    <div class="quiz-section__location">
      {% if section.settings.location_label != blank %}
        <p class="quiz-section__location-label">{{ section.settings.location_label | escape }}</p>
      {% endif %}
      {% if section.settings.location_city != blank %}
        <p class="quiz-section__location-city">{{ section.settings.location_city | escape }}</p>
      {% endif %}
    </div>

    <div class="quiz-section__dots" aria-hidden="true">
      <span class="quiz-section__dot quiz-section__dot--active"></span>
      <span class="quiz-section__dot"></span>
      <span class="quiz-section__dot"></span>
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .quiz-section {
    padding-block-start: var(--padding-block-start);
    padding-block-end: var(--padding-block-end);
  }
{% endstyle %}

{% stylesheet %}
  /* Base / Mobile styles */
  .quiz-section {
    display: flex;
    flex-direction: column;
  }

  /* Content panel */
  .quiz-section__content {
    order: 2;
    background-color: #F2F7FB;
    padding: 24px 16px;
  }

  .quiz-section__content-inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .quiz-section__text-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .quiz-section__subtitle {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 13px;
    line-height: 18px;
    letter-spacing: 0.52px;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin: 0;
  }

  .quiz-section__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 26px;
    line-height: 34px;
    letter-spacing: -0.52px;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .quiz-section__description {
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-style: var(--font-body--style);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0.14px;
    color: var(--color-foreground);
    margin: 0;
  }

  /* Contaminant card */
  .quiz-section__card {
    display: flex;
    background-color: #FFFFFF;
    border-radius: 5px;
    border: 1px solid var(--color-border);
  }

  .quiz-section__card-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  .quiz-section__card-label {
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-style: var(--font-body--style);
    font-size: 15px;
    line-height: 21px;
    color: var(--color-foreground);
    margin: 0;
  }

  .quiz-section__card-list {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-style: var(--font-body--style);
    font-size: 14px;
    line-height: 21px;
    color: var(--color-foreground);
    margin: 0;
  }

  .quiz-section__card-right {
    display: none;
  }

  /* CTA button */
  .quiz-section__btn {
    border-radius: 60px;
    font-size: 14px;
    line-height: 20px;
    padding: 10px 24px 12px;
    white-space: nowrap;
  }

  /* Media panel */
  .quiz-section__media {
    order: 1;
    position: relative;
    overflow: hidden;
    background-color: #202635;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px 16px;
    min-height: 318px;
    color: #FFFFFF;
  }

  .quiz-section__media-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .quiz-section__media-bg-image {
    position: absolute;
    inset: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 40px);
    object-fit: cover;
    opacity: 0.1;
    mix-blend-mode: screen;
    filter: blur(5px);
  }

  .quiz-section__gauge-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 270px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quiz-section__gauge {
    width: 100%;
    height: auto;
  }

  .quiz-section__count {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 84px;
    line-height: 119px;
    letter-spacing: -1.68px;
    text-align: center;
    color: #FFFFFF;
  }

  .quiz-section__location {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: center;
  }

  .quiz-section__location-label {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 13px;
    line-height: 18px;
    letter-spacing: 0.52px;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0;
  }

  .quiz-section__location-city {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 22px;
    line-height: 29px;
    letter-spacing: -0.22px;
    color: #FFFFFF;
    margin: 0;
  }

  .quiz-section__dots {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .quiz-section__dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #FFFFFF;
    opacity: 0.5;
  }

  .quiz-section__dot--active {
    opacity: 1;
  }

  /* Desktop overrides */
  @media screen and (min-width: 750px) {
    .quiz-section {
      flex-direction: row;
    }

    .quiz-section__content {
      order: unset;
      width: 50%;
      background-color: transparent;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .quiz-section__content-inner {
      max-width: 537px;
      width: 100%;
      padding: 40px;
      gap: 32px;
    }

    .quiz-section__text-group {
      gap: 16px;
    }

    .quiz-section__subtitle {
      font-size: 18px;
      line-height: 26px;
      letter-spacing: 0.72px;
    }

    .quiz-section__heading {
      font-size: 42px;
      line-height: 55px;
      letter-spacing: -0.84px;
    }

    .quiz-section__description {
      font-size: 18px;
      line-height: 25px;
      letter-spacing: 0;
    }

    .quiz-section__card-list {
      font-weight: 300;
    }

    .quiz-section__card-right {
      display: flex;
      align-items: center;
      justify-content: center;
      border-left: 1px solid #3383C5;
      width: 120px;
      flex-shrink: 0;
    }

    .quiz-section__btn {
      border-radius: 57px;
      font-size: 16px;
      line-height: 23px;
      padding: 10px 34px 13px;
    }

    .quiz-section__media {
      order: unset;
      width: 50%;
      min-height: 0;
      padding: 40px;
      gap: 24px;
    }

    .quiz-section__gauge-wrapper {
      max-width: 444px;
    }

    .quiz-section__count {
      font-size: 140px;
      line-height: 199px;
      letter-spacing: -2.8px;
    }

    .quiz-section__location-label {
      font-size: 18px;
      line-height: 26px;
      letter-spacing: 0.72px;
    }

    .quiz-section__location-city {
      font-size: 36px;
      line-height: 47px;
      letter-spacing: -0.36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quiz",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "TAKE THE QUIZ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover what's in your water"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Tap the button below to see the specific contaminants in your local water supply (and how to best protect yourself and your loved ones)."
    },
    {
      "type": "header",
      "content": "Contaminant card"
    },
    {
      "type": "text",
      "id": "contaminant_label",
      "label": "Card label",
      "default": "CONTAMINANTS WE REMOVE: NEW YORK"
    },
    {
      "type": "textarea",
      "id": "contaminant_list",
      "label": "Card list",
      "default": "Haloacetic acids (HAA5), Chromium, Chloroform, Trichloroacetic Acid, Bromoform, 1,4-Dioxane + 5 more."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Take the Quiz"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "text",
      "id": "contaminant_count",
      "label": "Count number",
      "default": "14"
    },
    {
      "type": "text",
      "id": "location_label",
      "label": "Location label",
      "default": "TOTAL CONTAMINANTS FOUND IN:"
    },
    {
      "type": "text",
      "id": "location_city",
      "label": "Location city",
      "default": "New York City"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Quiz"
    }
  ]
}
{% endschema %}
