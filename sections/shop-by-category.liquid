<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="shop-by-category-{{ section.id }}"
>
  <div class="shop-by-category" id="shop-by-category-{{ section.id }}">
    {% if section.settings.heading != blank %}
      <div class="shop-by-category__header">
        <h2 class="shop-by-category__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="shop-by-category__grid">
      {% for block in section.blocks %}
        <a
          class="shop-by-category__item"
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="shop-by-category__image-wrapper">
            {% if block.settings.image != blank %}
              {%- assign sizes_val = '(min-width: 750px) calc(var(--page-width) / 6), 132px' -%}
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                  sizes: sizes_val,
                  widths: '132,200,230,264,400,460',
                  loading: 'lazy',
                  class: 'shop-by-category__image',
                  alt: block.settings.image.alt | default: block.settings.title
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'shop-by-category__placeholder' }}
            {% endif %}
          </div>
          <span class="shop-by-category__title">{{ block.settings.title | escape }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} {
    border: 1px solid #D3D8DD;
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .spacing-style {
      --padding-block-start: 19px;
      --padding-block-end: 19px;
    }
  }
{% endstyle %}

{% stylesheet %}
.shop-by-category {
  display: flex;
  flex-direction: column;
}

.shop-by-category__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-block-end: 24px;
}

.shop-by-category__heading {
  font-family: var(--font-heading--family);
  font-weight: 400;
  font-size: 26px;
  line-height: 34px;
  letter-spacing: -0.52px;
  color: var(--color-foreground);
  margin: 0;
}

.shop-by-category__grid {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  gap: 16px;
}

.shop-by-category__grid::-webkit-scrollbar {
  display: none;
}

.shop-by-category__item {
  flex: 0 0 132px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  scroll-snap-align: start;
  text-decoration: none;
  color: inherit;
}

.shop-by-category__image-wrapper {
  aspect-ratio: 1;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F2F7FB;
  border-radius: 5px;
  overflow: hidden;
}

.shop-by-category__image {
  width: 73%;
  height: auto;
  object-fit: contain;
}

.shop-by-category__placeholder {
  width: 60%;
  height: 60%;
}

.shop-by-category__title {
  font-family: var(--font-heading--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  letter-spacing: -0.14px;
  color: var(--color-foreground);
}

@media screen and (min-width: 750px) {
  .shop-by-category__heading {
    font-size: 42px;
    line-height: 55px;
    letter-spacing: -0.84px;
  }

  .shop-by-category__grid {
    overflow: visible;
    justify-content: space-between;
  }

  .shop-by-category__item {
    flex: 1 1 0;
    min-width: 0;
    gap: 12px;
  }

  .shop-by-category__image-wrapper {
    border-radius: 0;
  }

  .shop-by-category__title {
    font-size: 18px;
    line-height: 25px;
    letter-spacing: 0;
    text-align: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Category",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by System"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 65
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 65
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "category": "t:categories.collections",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Filtered Pitcher"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Water Bottles"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Under Sink System"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Fridge Filter"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Replacement Filters"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Accessories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
