{% liquid
  assign color_scheme = section.settings.color_scheme
  assign section_width = section.settings.section_width
%}

<div class="section-background color-{{ color_scheme }}"></div>
<div
  class="section section--{{ section_width }} centered-headline color-{{ color_scheme }} spacing-style"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
  "
>
  <div class="centered-headline__content">
    {% if section.settings.subtitle != blank %}
      <p class="centered-headline__subtitle">{{ section.settings.subtitle | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="centered-headline__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .centered-headline {
    padding-block-start: var(--padding-block-start);
    padding-block-end: var(--padding-block-end);
  }
{% endstyle %}

{% stylesheet %}
  /* Base / Mobile styles */
  .centered-headline {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .centered-headline__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 354px;
    width: 100%;
  }

  .centered-headline__subtitle {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 13px;
    line-height: 18px;
    letter-spacing: 0.52px;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .centered-headline__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-style: var(--font-heading--style);
    font-size: 26px;
    line-height: 34px;
    letter-spacing: -0.52px;
    text-align: center;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  /* Desktop overrides */
  @media screen and (min-width: 750px) {
    .centered-headline__content {
      gap: 16px;
      max-width: 758px;
    }

    .centered-headline__subtitle {
      font-size: 18px;
      line-height: 26px;
      letter-spacing: 0.72px;
    }

    .centered-headline__heading {
      font-size: 42px;
      line-height: 55px;
      letter-spacing: -0.84px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Centered headline",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CLEAN WATER, CLEAR MIND"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dedicated To Your Health & Safety"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Centered headline"
    }
  ]
}
{% endschema %}
